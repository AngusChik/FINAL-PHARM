# Copy this file to ".env.development" for the isolated development checkout.
# Development and production may share one PostgreSQL server, but these names
# must differ. The development launcher and Django both refuse a match.
PHARMACY_ENVIRONMENT=development
DB_NAME=pharmacy_development
PRODUCTION_DB_NAME=postgres

# Setup generates this dedicated role and a private local password.
DB_USER=pharmacy_development
DB_PASSWORD=generated-by-development-setup
DB_HOST=127.0.0.1
DB_PORT=5432

# Tests use a separate, guarded database owned by the same development role.
DEVELOPMENT_TEST_DB_NAME=test_pharmacy_development

# Development is local-only. These values cannot re-enable outbound supplier,
# Google Sheet, or email delivery; settings_development.py disables them.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=development-only-change-me
