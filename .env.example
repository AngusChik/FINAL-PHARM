# Copy this file to ".env" and fill in real values. ".env" is gitignored.

# --- Core ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-real-secret-key

# LAN address of the server PC. Used by the production launcher and Caddy.
PHARMACY_HOST=192.168.0.15
DJANGO_ALLOWED_HOSTS=192.168.0.15,localhost,127.0.0.1

# Set to "true" ONLY on a developer machine. Leave false/unset in production.
DJANGO_DEBUG=false

# --- HTTPS hardening ---
# The production settings module enables secure mode automatically.
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.0.15,https://localhost

# --- Database ---
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Verified database backups ---
# Relative paths are resolved from the project folder. For stronger disaster
# recovery, point this at a secured external drive or network backup location.
PHARMACY_BACKUP_DIR=backups\database
PHARMACY_BACKUP_RETENTION_DAYS=30
# Set only if pg_dump/pg_restore are not on PATH.
POSTGRESQL_BIN=
